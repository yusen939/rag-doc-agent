# Ollama
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text
REQUEST_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Retrieval
CHUNK_SIZE=700
CHUNK_OVERLAP=120
RETRIEVE_TOP_K=8
RERANK_TOP_N=4
MAX_FILE_MB=20

# local | chroma
VECTOR_BACKEND=local
CHROMA_COLLECTION=documents

# Optional. Leave empty to use in-memory sessions.
REDIS_URL=
SESSION_TTL_SECONDS=21600
HISTORY_MESSAGES=10

DATA_DIR=data
